@{
    ViewData["Title"] = "Plans";

}
@using Gym.BusinessLogic.ViewModels.Plan
@model PlanEditViewModel
<div class="container-fluid px-4 mt-4">
    <div class="plan-full-width-edit">
        
        <div class="edit-header-section mb-5">
            <div class="d-flex align-items-center gap-3">
                <div class="icon-box-orange">
                    <i class="bi bi-pencil-square fs-3"></i>
                </div>
                <div>
                   
               
              

                <div>
                    <h2 class="fw-bold mb-1 text-dark">Edit Plan Management</h2>
                    <p class="text-muted mb-0">Update subscription details, pricing, and availability parameters</p>
                </div>
            </div>
            <hr class="header-divider" />
        </div>

        <form asp-action="Edit" method="post">
            <div class="row">
                <div class="col-lg-8">
                    
                    <div class="fw-form-group mb-4">
                        <label class="form-label">Plan Name</label>
                        <input type="text" class="form-control fw-edit-input" asp-for="Name" placeholder="Enter the subscription name..." />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="fw-form-group mb-4">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control fw-edit-input" rows="6" placeholder="Provide a detailed description of what this fitness plan includes...">Full access to gym facilities, personalized workout schedule, and 5 private sessions with a certified trainer.</textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                </div>

                <div class="col-lg-4">
                    
                    <div class="fw-form-group mb-4">
                        <label class="form-label">Price (EGP)</label>
                        <div class="input-group">
                            <input  class="form-control fw-edit-input" asp-for="Price" placeholder="0.00" />
                            <span class="input-group-text custom-addon">EGP</span>
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="fw-form-group mb-4">
                        <label class="form-label">Duration (Days)</label>
                        <div class="input-group">
                            <input type="number" class="form-control fw-edit-input" asp-for="DurationDays" placeholder="30" />
                            <span class="input-group-text custom-addon">Days</span>
                            <span asp-validation-for="DurationDays" class="text-danger"></span>
                        </div>
                    </div>

                   

                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <div class="fw-action-bar d-flex justify-content-end gap-3 py-3">
                        <a asp-action="Index" asp-controller="Plan" class="btn btn-fw-cancel">Cancel</a>
                        <button type="submit" class="btn btn-fw-save">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </form>
        @section Scripts {
                <partial name="_ValidationScriptsPartial" />
        }

    </div>
</div>