@{
    ViewData["Title"] = "Trainers";

}
@using Gym.BusinessLogic.ViewModels.Trainer
@model TrainerDetailsViewModel
<div class="container-fluid px-5">
    <main role="main" class="pb-5 mt-4">
        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-12">
                    <div class="card card-trainer-details border-0 shadow-none">
                        <div class="card-body p-0">
                            
                            <div class="trainer-header-zone text-center mb-5">
                                <div class="trainer-badge-icon-wrapper mb-3">
                                    <i class="bi bi-person-badge-fill text-primary-color"></i>
                                </div>
                                <h2 class="trainer-name-heading">@Model.Name</h2>
                                <span class="badge trainer-spec-tag mt-2">@Model.Specialization</span>
                            </div>

                            <div class="trainer-info-grid">
                                <div class="row g-4">
                                    
                                    <div class="col-12 col-md-6">
                                        <div class="detail-display-box">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box-circle me-3">
                                                    <i class="bi bi-envelope-fill"></i>
                                                </div>
                                                <div>
                                                    <small class="detail-label">Email Address</small>
                                                    <p class="detail-value">@Model.Email</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="detail-display-box">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box-circle me-3">
                                                    <i class="bi bi-telephone-fill"></i>
                                                </div>
                                                <div>
                                                    <small class="detail-label">Phone Number</small>
                                                    <p class="detail-value">@Model.Phone</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="detail-display-box">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box-circle me-3">
                                                    <i class="bi bi-calendar-event-fill"></i>
                                                </div>
                                                <div>
                                                    <small class="detail-label">Date Of Birth</small>
                                                    <p class="detail-value">@Model.DateOfBirth.ToString("dd/MM/yyyy")</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="detail-display-box">
                                            <div class="d-flex align-items-center">
                                                <div class="icon-box-circle me-3">
                                                    <i class="bi bi-geo-alt-fill"></i>
                                                </div>
                                                <div>
                                                    <small class="detail-label">Address Location</small>
                                                    <p class="detail-value">@Model.Address</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>

                            <footer class="form-action-footer d-flex justify-content-end mt-5">
                                <a asp-controller="Trainer" asp-action="Index" class="btn-cancel-outline">
                                    Back to List
                                </a>
                            </footer>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
@section Styles{
    <link rel="stylesheet" href="~/css/TrainerDetails.css"/>
}