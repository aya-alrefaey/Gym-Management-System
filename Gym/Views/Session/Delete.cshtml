@{
    ViewData["Title"] = "Delete Session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-5">
    <main role="main" class="pb-5 mt-4">

        <div class="container mt-4">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card card-delete-session border-0 shadow-none text-center">
                        <div class="card-body p-0">

                            <div class="delete-icon-warning-wrapper mb-4">
                                <i class="bi bi-exclamation-triangle-fill"></i>
                            </div>

                            <div class="form-header-zone border-0 mb-3 pb-2 text-center">
                                <h2 class="member-name-heading text-danger-color">Delete Session</h2>
                                <p class="text-muted fs-6">Are you sure you want to permanently delete this training session?</p>
                            </div>

                            <div class="tech-alert-warning-box text-start mb-5">
                                <strong><i class="bi bi-info-circle-fill me-2"></i>Warning:</strong>
                                This action cannot be undone. All session data and related bookings will be permanently erased from the system.
                            </div>

                            <form asp-action="DeleteConfirmation" asp-route-id="@Context.Request.RouteValues["id"]" method="post">
                                <footer class="form-action-footer d-flex justify-content-center gap-3 border-0 mt-4 pt-0">
                                    <a asp-action="Index" class="btn-cancel-outline px-4">
                                        <i class="bi bi-x-lg me-2"></i>Cancel
                                    </a>
                                    <button type="submit" class="btn-delete-submit px-4">
                                        <i class="bi bi-trash me-2"></i>Confirm Delete
                                    </button>
                                </footer>
                            </form>

                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/DeleteSession.css" />
}