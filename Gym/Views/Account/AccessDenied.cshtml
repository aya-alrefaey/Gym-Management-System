@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Route Fitness</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/AccessDenied.css" />
</head>
<body>
    <div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 px-3">
        <div class="access-denied-wrapper">
            <!-- Left Content -->
            <div class="content-section">
                <div class="error-icon-wrapper">
                    <i class="bi bi-shield-x"></i>
                </div>
                <h1 class="error-heading">
                    Access <span class="error-highlight">Denied</span>
                </h1>
                <p class="error-message">
                    We're sorry, but you don't have permission to access this resource. Your current user role or membership status doesn't grant you access to this section.
                </p>
                <div class="error-code-box">
                    <span class="code-label">Status:</span> Error Code 403 - Forbidden Access
                </div>
                <p class="error-message opacity-75">
                    If you believe this is an error or need elevated permissions, please contact the system administrator or your membership manager for assistance.
                </p>
                <div class="button-group-zone">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-primary-spec">
                        <i class="bi bi-house-door-fill me-2"></i>Return to Home
                    </a>
                </div>
            </div>

            <!-- Right Visual Section -->
            <div class="visual-section">
                <div class="lock-icon-glow">
                    <i class="bi bi-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
</body>
</html>