@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
   
    <link rel="stylesheet" href="~/css/style.css" />
    @RenderSection("Styles", required: false)
    <title>Power fitness | @ViewData["Title"]</title>
</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg bg-white sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-primary-color" href="#">
                POWER<span class="text-dark">FITNESS</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 mt-3 mt-lg-0 align-items-center">
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Home" ? "active" : "")"
                               asp-action="Index"
                               asp-controller="Home">
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Member" ? "active" : "")"
                               asp-action="Index"
                               asp-controller="Member">
                            Members
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Trainer" ? "active" : "")"
                               asp-action="Index"
                               asp-controller="Trainer">
                           Trainers 
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link px-3 py-2 @(currentController == "Session" ? "active" : "")" asp-action="Index" asp-controller="Session">Sessions</a></li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Plan" ? "active" : "")"
                               asp-action="Index"
                               asp-controller="Plan">
                            Plans
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Membership" ? "active" : "")"
                           asp-action="Index"
                           asp-controller="Membership">
                            Memberships
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 py-2 @(currentController == "Booking" ? "active" : "")"
                           asp-action="Index"
                           asp-controller="Booking">
                            Schedule
                        </a>
                    </li>
                    <li class="nav-item ms-lg-3">
                        <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm px-3 rounded-pill">Logout</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


   
       
            @RenderBody()
      
   

    <!-- Footer -->
    <footer class="main-footer bg-dark text-white pt-5 mt-5">
        <div class="container position-relative">

        
            <div class="floating-orange-bar bg-primary-color py-3 px-4 rounded-4 text-white fw-bold text-uppercase shadow">
                <div class="d-flex justify-content-around align-items-center flex-wrap gap-2 text-center">
                    <span class="bar-item"><i class="bi bi-lightning-charge-fill me-2"></i>Outdoor & Online Trainers</span>
                    <span class="bar-separator d-none d-md-inline">|</span>
                    <span class="bar-item"><i class="bi bi-person-heart me-2"></i>Personal Training</span>
                    <span class="bar-separator d-none d-md-inline">|</span>
                    <span class="bar-item"><i class="bi bi-fire me-2"></i>Live Classes</span>
                </div>
            </div>

           
            <div class="row g-4 footer-links-content">
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-primary-color mb-3 tracking-wide">POWER<span class="text-white">FITNESS</span></h5>
                    <p class="text-light-muted small lh-lg">Push harder, go further. Your fitness journey starts today! Build your body and mind with our elite coaches.</p>
                </div>
            
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-uppercase mb-3 fs-6 footer-title">Contact Us</h5>
                    <ul class="list-unstyled text-light-muted small">
                        <li class="mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-telephone-fill text-primary-color"></i>
                            <span>+91 123 456 789</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope-fill text-primary-color"></i>
                            <span>info@gmail.com</span>
                        </li>
                    </ul>
                </div>
            
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-uppercase mb-3 fs-6 footer-title">Our Gym Timing</h5>
                    <ul class="list-unstyled text-light-muted small">
                        <li class="mb-2"><strong>Mon - Fri :</strong> 08:00 AM - 10:00 PM</li>
                        <li><strong>Sat - Sun :</strong> 08:00 AM - 09:00 PM</li>
                    </ul>
                </div>
            
                <div class="col-lg-3 col-md-6">
                    <h5 class="fw-bold text-uppercase mb-3 fs-6 footer-title">Our Location</h5>
                    <p class="text-light-muted small lh-base">
                        <i class="bi bi-geo-alt-fill text-primary-color me-1"></i>
                        2715 Ash Dr. San Jose, South Dakota 83475
                    </p>
                </div>
            </div>
        </div>

      
        <div class="footer-bottom mt-5 py-3 border-top border-secondary">
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small text-light-muted">
                    <p class="mb-0">&copy; 2026 <strong>PowerFitness</strong>. All Rights Reserved.</p>
                    <div class="footer-bottom-links">
                        <a href="#" class="text-light-muted text-decoration-none me-3 hover-primary">Privacy Policy</a>
                        <a href="#" class="text-light-muted text-decoration-none hover-primary">Terms of Service</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>