@using Gym.BusinessLogic.ViewModels.Home
@{
    ViewData["Title"] = "Home";

}
@model HomeStatsViewModel
    <header class="hero-section py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 col-12">
                    <div class="info mt-4">
                        <h2 class="fw-bolder display-3 mb-4 text-dark">
                            Your body can <span class="text-primary-color">stand almost</span> anything
                        </h2>
                        <p class="lead mb-5 text-muted text-justify">
                            It's your mind that needs convincing. Push past your limits, stay committed, and watch as your body transforms into a powerhouse of strength and resilience. Start your journey today and see what you are truly capable of!
                        </p>

                        <div class="stats-bar shadow-sm p-4 rounded-4 bg-white mb-5">
                            <div class="row text-center g-3">
                                <div class="col-4 border-end">
                                    <span class="fw-bolder fs-3 text-primary-color d-block">@Model.TotalMembers</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Total Members</h3>
                                </div>
                                <div class="col-4 border-end">
                                    <span class="fw-bolder fs-3 text-success d-block">@Model.ActiveMembers</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Active Members</h3>
                                </div>
                                <div class="col-4">
                                    <span class="fw-bolder fs-3 text-dark d-block">@Model.TrainersCount</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Trainers</h3>
                                </div>
                            </div>
                            <hr class="my-3 text-muted opacity-25">
                            <div class="row text-center g-3">
                                <div class="col-4 border-end">
                                    <span class="fw-bolder fs-3 text-warning d-block">@Model.UpcomingSessions</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Upcoming</h3>
                                </div>
                                <div class="col-4 border-end">
                                    <span class="fw-bolder fs-3 text-info d-block">@Model.OngoingSessions</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Ongoing</h3>
                                </div>
                                <div class="col-4">
                                    <span class="fw-bolder fs-3 text-secondary d-block">@Model.CompletedSessions</span>
                                    <h3 class="fs-6 text-muted fw-normal mb-0">Completed</h3>
                                </div>
                            </div>
                        </div>

                        <div class="buttons mb-4">
                            <button class="btn btn-primary-custom px-4 py-2 me-3 rounded-pill shadow-sm">Get Started</button>
                            <button class="btn btn-outline-custom px-4 py-2 rounded-pill">Explore More</button>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 col-12 order-first order-md-last mb-4 mb-md-0">
                    <div class="character-img-wrapper text-center">
                        <div class="character-bg-shape">
                            <i class="bi bi-lightning-charge-fill display-1 text-white"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

  
    <div class="moving-bar bg-primary-color py-3 text-white fw-bolder text-uppercase">
        <div class="d-flex justify-content-around align-items-center text-nowrap overflow-hidden">
            <span>Outdoor & Online Trainers <i class="bi bi-star-fill mx-2"></i></span>
            <span>Personal Training <i class="bi bi-star-fill mx-2"></i></span>
            <span>Live Classes <i class="bi bi-star-fill mx-2"></i></span>
            <span class="d-none d-md-inline">Expert Coaches <i class="bi bi-star-fill mx-2"></i></span>
        </div>
    </div>
    <main class="container my-5 pb-3">
        
    
        <section class="about-section my-5 py-5">
            <div class="row g-5 align-items-center">
                <div class="col-12 col-lg-6">
                    <div class="about-images-gridposition-relative">
                       
                        <div class="about-placeholder-box shadow-lg rounded-4 p-5 text-center text-white">
                            <i class="bi bi-gym display-2 text-white mb-3"></i>
                            <h4>Your Fitness Sanctuary</h4>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-6">
                    <div class="title d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-award-fill text-primary-color fs-4"></i>
                        <h2 class="text-primary-color fs-5 fw-bold mb-0">About Us</h2>
                    </div>

                    <header>
                        <p class="fw-bolder h1 mb-4 text-dark text-uppercase">
                            Empowering you to achieve <span class="text-primary-color">your fitness</span> goals
                        </p>
                        <p class="text-muted mb-4 lead-sm">
                            We believe fitness is more than just a workout—it's a lifestyle. With top-of-the-line facilities, certified trainers, and a supportive community, we're here to inspire and guide you every step of the way.
                        </p>
                    </header>

                   
                    <div class="features mt-4">
                        <div class="row row-cols-1 row-cols-sm-2 g-4">
                            <div class="col">
                                <div class="feature-card p-3 rounded-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-person-check-fill text-primary-color fs-4"></i>
                                        <h3 class="fw-bold fs-6 mb-0">Personal Trainer</h3>
                                    </div>
                                    <p class="text-muted small mb-0">Achieve your fitness goals with the guidance of our certified trainers.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card p-3 rounded-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-heart-pulse-fill text-primary-color fs-4"></i>
                                        <h3 class="fw-bold fs-6 mb-0">Cardio Programs</h3>
                                    </div>
                                    <p class="text-muted small mb-0">Boost your endurance and heart health with modern tracks.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card p-3 rounded-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-capsule text-primary-color fs-4"></i>
                                        <h3 class="fw-bold fs-6 mb-0">Nutritional Plans</h3>
                                    </div>
                                    <p class="text-muted small mb-0">Get customized diet charts designed by expert nutritionists.</p>
                                </div>
                            </div>
                            <div class="col">
                                <div class="feature-card p-3 rounded-3 shadow-sm bg-white">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-calendar3 text-primary-color fs-4"></i>
                                        <h3 class="fw-bold fs-6 mb-0">Flexible Schedule</h3>
                                    </div>
                                    <p class="text-muted small mb-0">Book your preferred slots seamlessly at any time.</p>
                                </div>
                            </div>
                        </div>
                        <button class="btn btn-primary-custom rounded-pill px-4 py-2 mt-4 shadow-sm">Get Started</button>
                    </div>
                </div>
            </div>
        </section>

      
        <section class="workout-section my-5 py-5 bg-dark text-white rounded-4 p-4 p-md-5">
            <div class="title text-center mb-5">
                <span class="text-primary-color fw-bold text-uppercase tracking-wider">Workouts</span>
                <h2 class="fw-bolder display-5 mt-2">Transform Your Body with Dynamic Workouts</h2>
            </div>

            <div class="row row-cols-1 row-cols-md-3 g-4">
                <div class="col">
                    <div class="card workout-card h-100 border-0 bg-secondary-dark text-white rounded-4 overflow-hidden">
                        <div class="card-body-custom p-4 text-center">
                            <i class="bi bi-people-fill text-primary-color display-4 mb-3 d-block"></i>
                            <h5 class="card-title text-uppercase fw-bolder">Group Workout</h5>
                            <p class="text-muted small">High-energy sessions with supportive peers.</p>
                            <a href="#" class="btn btn-link text-primary-color p-0 mt-3 text-decoration-none fw-bold">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card workout-card h-100 border-0 bg-secondary-dark text-white rounded-4 overflow-hidden">
                        <div class="card-body-custom p-4 text-center">
                            <i class="bi bi-lightning-fill text-primary-color display-4 mb-3 d-block"></i>
                            <h5 class="card-title text-uppercase fw-bolder">Cardio Burn</h5>
                            <p class="text-muted small">Melt fat and increase stamina efficiently.</p>
                            <a href="#" class="btn btn-link text-primary-color p-0 mt-3 text-decoration-none fw-bold">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card workout-card h-100 border-0 bg-secondary-dark text-white rounded-4 overflow-hidden">
                        <div class="card-body-custom p-4 text-center">
                            <i class="bi bi-fire text-primary-color display-4 mb-3 d-block"></i>
                            <h5 class="card-title text-uppercase fw-bolder">Strength Training</h5>
                            <p class="text-muted small">Build heavy muscles and solid skeleton.</p>
                            <a href="#" class="btn btn-link text-primary-color p-0 mt-3 text-decoration-none fw-bold">Explore <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

      
        <section class="why-us-section my-5 py-5">
            <div class="row align-items-center g-5">
                <div class="col-12 col-lg-6">
                    <div class="title d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-question-circle-fill text-primary-color fs-4"></i>
                        <h2 class="text-primary-color fs-5 fw-bold mb-0">Why Us</h2>
                    </div>

                    <header class="mb-4">
                        <p class="fw-bolder h1 mb-4 text-dark">
                            Elevate fitness with <br /><span class="text-primary-color">the best way</span> possible
                        </p>
                        <p class="text-muted">
                            We pride ourselves on offering an unrivaled environment that pushes boundaries and fosters true transformation.
                        </p>
                    </header>

                    <ul class="features-list list-unstyled mt-4">
                        <li class="d-flex gap-4 align-items-start mb-4">
                            <div class="count-badge bg-primary-color text-white rounded-circle fw-bold p-2 px-3">01</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-1">Personalized Fitness Plans</h3>
                                <p class="text-muted mb-0">We tailor every workout to fit your unique goals and fitness level ensuring maximum progress.</p>
                            </div>
                        </li>
                        <li class="d-flex gap-4 align-items-start mb-4">
                            <div class="count-badge bg-primary-color text-white rounded-circle fw-bold p-2 px-3">02</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-1">Elite Coaching Team</h3>
                                <p class="text-muted mb-0">Our coaches aren't just trainers; they are experts dedicated to your form and motivation.</p>
                            </div>
                        </li>
                        <li class="d-flex gap-4 align-items-start">
                            <div class="count-badge bg-primary-color text-white rounded-circle fw-bold p-2 px-3">03</div>
                            <div>
                                <h3 class="text-capitalize fw-bold fs-5 mb-1">Top-Tier Equipment</h3>
                                <p class="text-muted mb-0">Train with precision using modern, industry-leading strength and cardio machines.</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="col-12 col-lg-6 d-none d-lg-block">
                    <div class="why-us-placeholder text-center p-5 bg-light rounded-4 shadow-sm">
                        <i class="bi bi-shield-check text-primary-color display-1"></i>
                        <h3 class="mt-3 fw-bold">Certified & Secured</h3>
                    </div>
                </div>
            </div>
        </section>
    </main>

  
   